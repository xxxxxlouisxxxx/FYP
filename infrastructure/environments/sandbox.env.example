# Copy to infrastructure/environments/sandbox.env (git-ignored) and `set -a; . ./sandbox.env; set +a`.
# Every value is optional; the defaults run fully offline on sandbox fixtures and the mock model.
HOP_ENV=sandbox
HOP_DATA_DIR=var
# DATABASE_URL=postgresql+psycopg://hop:hop@localhost:5432/hop
HOP_SERP_PROVIDER=auto
HOP_MODEL_PROVIDER=auto
HOP_KILL_SWITCH=0
# Real providers: store these in a secrets manager, never in git.
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
